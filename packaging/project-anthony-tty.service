[Unit]
Description=Project Anthony rescue TUI on TTY3
Documentation=file:///usr/share/doc/project-anthony/README.txt
After=multi-user.target
Conflicts=getty@tty3.service

[Service]
Type=simple
ExecStart=/usr/local/bin/project-anthony-tty
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
Restart=always
RestartSec=2
StartLimitIntervalSec=0
User=root
WorkingDirectory=/root
Environment=TERM=linux
Environment=PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LESSSECURE=1
Environment=HOME=/root
NoNewPrivileges=yes
PrivateTmp=yes
# Removable media is mounted read-only under /run to check a rescue USB.
# hidraw stays visible so an optional FIDO2 key can be touched on TTY3.
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
