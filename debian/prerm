#!/bin/bash
# =========================================================================
#   PROJECT ANTHONY: PRE-REMOVAL MAINTAINER SYSTEM TEARDOWN HOOK
# =========================================================================

systemctl stop project-anthony-monitor.service 2>/dev/null || true
systemctl disable project-anthony-monitor.service 2>/dev/null || true
systemctl stop project-anthony-tty.service 2>/dev/null || true
systemctl disable project-anthony-tty.service 2>/dev/null || true

# DPKG_MAINTSCRIPT_PACKAGE is set here so --uninstall leaves packaged files to dpkg
if [ -f /usr/local/bin/project-anthony ]; then
    /usr/local/bin/project-anthony --uninstall
fi

exit 0
